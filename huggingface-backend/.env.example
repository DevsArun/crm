# ============================================================
# WhatsApp CRM Engine — Environment Variables
# Copy this to .env and fill in values
# NEVER commit .env to version control
# ============================================================

# ── Server Configuration ─────────────────────────────────────
# Hugging Face Spaces requires port 7860
PORT=7860
NODE_ENV=production

# ── Security ─────────────────────────────────────────────────
# Secret key for validating requests from PHP (Hostinger)
# Generate: openssl rand -hex 32
NODE_API_KEY=your_strong_api_key_here_change_this

# Secret for outgoing webhooks to PHP (Hostinger)
# Must match webhook_secret in PHP config/app.php
WEBHOOK_SECRET=your_webhook_secret_here_change_this

# ── Hostinger PHP Backend ────────────────────────────────────
# Base URL of your Hostinger site (with trailing slash)
HOSTINGER_WEBHOOK_URL=https://yourdomain.com/webhook.php

# Retry failed webhooks (number of attempts)
WEBHOOK_RETRY_ATTEMPTS=3

# Delay between webhook retries in ms
WEBHOOK_RETRY_DELAY=2000

# ── CORS Configuration ───────────────────────────────────────
# Comma-separated list of allowed origins
# Add your Hostinger domain + HF Space URL
CORS_ORIGINS=https://yourdomain.com,https://your-space.hf.space

# ── WhatsApp Session ─────────────────────────────────────────
# Session data directory (persisted in HF Space)
WA_SESSION_PATH=./wa_session

# Session client ID (change if running multiple instances)
WA_SESSION_ID=whatsapp-crm-default

# Auto-restart WhatsApp client on disconnect (true/false)
WA_AUTO_RESTART=true

# Interval to check WA connection health (ms)
WA_HEALTH_CHECK_INTERVAL=30000

# ── Queue Configuration ──────────────────────────────────────
# Default min delay between messages (seconds)
QUEUE_DELAY_MIN=120

# Default max delay between messages (seconds)
QUEUE_DELAY_MAX=300

# Max messages per day (safety cap regardless of campaign settings)
QUEUE_DAILY_MAX=100

# Max retries for failed sends
QUEUE_MAX_RETRIES=3

# ── Rate Limiting ─────────────────────────────────────────────
# Max API requests per 15-minute window per IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=7
LOG_MAX_SIZE=10m

# ── Puppeteer / Chromium ─────────────────────────────────────
# Set automatically by Dockerfile — override if needed
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# ── Feature Flags ────────────────────────────────────────────
ENABLE_QR_TERMINAL=false
ENABLE_MESSAGE_PREVIEW_LOG=true
